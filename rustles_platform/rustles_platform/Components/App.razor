<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["rustles_platform.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <div id="cookie-notice" class="cookie-notice" hidden>
        <p>
            Rustles uses only strictly necessary authentication cookies for signing in, staying signed in,
            and protecting account actions.
        </p>
        <button type="button" onclick="RustlesCookieNotice.accept()">Accept</button>
    </div>
    <script>
        window.RustlesCookieNotice = {
            accept: () => {
                localStorage.setItem("rustles-cookie-notice-accepted", "true");
                document.getElementById("cookie-notice")?.setAttribute("hidden", "");
            }
        };

        if (localStorage.getItem("rustles-cookie-notice-accepted") !== "true") {
            document.getElementById("cookie-notice")?.removeAttribute("hidden");
        }
    </script>
    <script src="@Assets["js/geolocation.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private static readonly IComponentRenderMode WasmOnly =
    new InteractiveWebAssemblyRenderMode(prerender: false);

    private IComponentRenderMode? PageRenderMode => EvalRenderMode();


    private IComponentRenderMode? EvalRenderMode()
    {
        if (!HttpContext.AcceptsInteractiveRouting())
            return null;

        if (HttpContext.Request.Path.StartsWithSegments("/municipality/chat"))
            return WasmOnly;

        return InteractiveWebAssembly;
    }
}
