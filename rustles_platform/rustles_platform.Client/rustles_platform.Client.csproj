<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <BlazorWebAssemblyEnableLinking>false</BlazorWebAssemblyEnableLinking>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.6" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\rustles.contracts\rustles.contracts.csproj" />
  </ItemGroup>

	<Target Name="NpmInstall" BeforeTargets="Build" Condition="!Exists('node_modules')">
		<!-- Ensure node_modules exists. Only runs if missing to save time. -->
		<Exec Command="npm install" />
	</Target>

	<Target Name="NpmBuild" BeforeTargets="Build" DependsOnTargets="NpmInstall">
		<!-- Always run the build script to ensure JS is up to date -->
		<Exec Command="npm run build" />
	</Target>

</Project>
