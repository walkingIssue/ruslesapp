@page "/municipality/chat"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject NavigationManager Navigation

<h3>Chat</h3>

<p>@message</p>
<p>@url</p>
<button @onclick="SendMessage">Send Message</button>

@code {
    private string message = string.Empty;
    private HubConnection? munipHub;
    private string url = string.Empty;

    public record Position(double lat, double longi);

    private async Task SendMessage()
    {
        if (munipHub is not null)
        {
            try
            {
                await munipHub.InvokeAsync("HelloUser", "test_user");
                Console.WriteLine("Message sent to hub.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error sending message: {ex.Message}");
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        url = Navigation.ToAbsoluteUri("/hubs/municipality").ToString();
        munipHub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/municipality"))
            .WithAutomaticReconnect()
            .Build();

        munipHub.On<string>("ReceiveMessage", receivedMessage =>
        {
            message = receivedMessage;
            Console.WriteLine($"Received message: {receivedMessage}");
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await munipHub.StartAsync();
            Console.WriteLine("Connected to municipality hub.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error connecting to hub: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (munipHub is not null)
        {
            await munipHub.DisposeAsync();
        }
    }
}
