@page "/municipality/chat"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text
@using rustles.contracts
@using rustles_platform.Client.Pages.Municipality.DTOs;
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject HttpClient requestClient
@inject AntiforgeryStateProvider afState
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />

<h3>Chat</h3>
@foreach (var msg in userMessages)
{
    <p>@msg</p>
}

<p>@url</p>
<textarea @bind="chatMessage" placeholder="Enter message to send"></textarea>
<button @onclick="(e) => SendMessage(chatMessage)">Send Message</button>

<div class="container">
    <div class="row">
        @if (chatError is not null)
        {
            <div class="col-6 --bs-danger">
                <p class="bg-danger">@chatErrorMessage</p>
            </div>
        }
    </div>
</div>

@code {
    private List<string> userMessages = [];
    private List<string> message = [];
    private HubConnection? munipHub;
    private bool enqueOk = false;
    private string url = string.Empty;
    private int currentValue = 0;
    private Guid client = Guid.NewGuid();
    private string chatMessage = string.Empty;
    private MunipChatError? chatError = null;
    private string chatErrorMessage ="We spazzed out for some reason, there's an error on the line";
    private UserConsent? consent = null;


    public record Position(double latti, double longi);

    private Task<HttpResponseMessage> RequestEnque(Position position)
    {
        var request = new HttpRequestMessage(HttpMethod.Post, "api/ConnectMunip");
        request.Headers.Add("RequestVerificationToken", afState.GetAntiforgeryToken()!.Value);
        request.Content = JsonContent.Create(position);
        return requestClient.SendAsync(request);
    }

    private async Task SendMessage(string msg)
    {
        if (munipHub is not null)
        {
            try
            {
                var t = munipHub.MunipChat(msg);
                userMessages.Add($"Sent: {msg}");
                await InvokeAsync(StateHasChanged);
                Console.WriteLine("Message sent to hub.");
                await t;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error sending message: {ex.Message}");
            }
        }
    }

    private async Task HandleMunipConnection(ConnectMunipAck connectAck)
    {
        userMessages.Clear();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(500);
        message.Add(connectAck.Message);
        foreach(var mess in connectAck.Catchup)
        {
            await Task.Delay(200);
            userMessages.Add(userMessageBuilder(mess));
            await InvokeAsync(StateHasChanged);
        }
    }

    private string userMessageBuilder(MunipChatMessage mess)
    {
        return $"{mess.DisplayName}: {mess.Message}   :{mess.SentAt}";
    }

    private void InitializeHub()
    {
        url = Navigation.ToAbsoluteUri("/hubs/municipality").ToString();
        munipHub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/hubs/municipality"))
            .WithAutomaticReconnect()
            .Build();
    }
    private async Task<UserConsent?> ConsentHandler(int intervalSeconds)
    {
        UserConsent? consent = null;
        try
        {
            consent = await JS.InvokeAsync<UserConsent>("RustlesGeo.assertGeolocationCompliance", intervalSeconds); 

        }catch(Exception e) when (e is JSException)
        {
            return null;
        }
        return consent;
    }

    protected override async Task OnInitializedAsync()
    {
        HttpResponseMessage? message = null;
        this.consent = await ConsentHandler(5);
        if (this.consent is not null && consent.consented && consent.latti is not null && consent.longi is not null)
        {
            message = await RequestEnque(new Position(consent.latti.Value, consent.longi.Value));
            if (message.IsSuccessStatusCode)
                enqueOk = true;
            await InvokeAsync(StateHasChanged);
        }
        if(this.consent is null)
        {
            chatError = new(ConnectionFault.fail, ChatErrorMessage.clientDenied);
            chatErrorMessage = "We cannot proceed without the Geolocation API consent, if you changed your mind, please reload the page";
        }

        if (enqueOk)
        {
            InitializeHub();
            munipHub.On<MunipChatMessage>(nameof(IMunipClientMethods.MessageByUser), (munipMessage) =>
            {
                string user = munipMessage.DisplayName;
                userMessages.Add(userMessageBuilder(munipMessage));
                InvokeAsync(StateHasChanged);
            });

            munipHub.On<MunipChatError>(nameof(IMunipClientMethods.ConnectionError), (error) =>
            {
                chatError = error;
                InvokeAsync(StateHasChanged);
            });
            munipHub.On<ConnectMunipAck>(nameof(IMunipClientMethods.MunipConnect), async (ack) =>
            {
                await HandleMunipConnection(ack);
            });

            try
            {
                await munipHub.StartAsync();
                Console.WriteLine("Connected to municipality hub.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error connecting to hub: {ex.Message}");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (munipHub is not null)
        {
            await munipHub.DisposeAsync();
        }
    }
}

